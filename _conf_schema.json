{
  "check_interval": {
    "type": "int",
    "default": 60,
    "description": "直播状态轮询间隔（秒）",
    "hint": "范围 30 到 1800 秒。YouTube 为节省 API 配额，会额外缓存 5 分钟。"
  },
  "notice_mode": {
    "type": "string",
    "default": "both",
    "description": "播报类型",
    "hint": "同时应用于开播和关播提醒。只发图卡时，如果图卡生成失败，会发送文字提醒。",
    "options": ["card", "text", "both"],
    "labels": ["图卡", "文字版", "文字+图卡"]
  },
  "twitch_client_id": {
    "type": "string",
    "default": "",
    "description": "Twitch Client ID",
    "secret": true
  },
  "twitch_client_secret": {
    "type": "string",
    "default": "",
    "description": "Twitch Client Secret",
    "secret": true
  },
  "kick_client_id": {
    "type": "string",
    "default": "",
    "description": "Kick Client ID",
    "secret": true
  },
  "kick_client_secret": {
    "type": "string",
    "default": "",
    "description": "Kick Client Secret",
    "secret": true
  },
  "youtube_api_key": {
    "type": "string",
    "default": "",
    "description": "YouTube Data API Key",
    "hint": "YouTube 查询使用 Data API 搜索接口，会消耗 Google Cloud 项目配额。",
    "secret": true
  },
  "font_path": {
    "type": "string",
    "default": "",
    "description": "中文字体文件路径",
    "hint": "留空时后台下载并缓存霞鹜文楷屏幕版，下载前使用可用的系统中文字体。也可填写容器内的字体文件路径。"
  }
}
